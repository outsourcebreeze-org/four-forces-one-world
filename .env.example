# Copy to .env. Never commit .env.

# NVIDIA Nemotron on Nebius Token Factory. Without this key the app still
# loads live public feeds and serves template briefs labeled as demo.
NEBIUS_API_KEY=

# Optional. Verified default:
# https://api.tokenfactory.nebius.com/v1/
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional model overrides. Defaults were checked on 13 Oct 2026.
# Triage / scoring. Nano returns content directly.
NEMOTRON_TRIAGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Situation briefs. Super is a reasoning model: the client sends max_tokens of 4000.
# If the content field comes back empty, the brief is retried on the triage model.
NEMOTRON_BRIEF_MODEL=nvidia/nemotron-3-super-120b-a12b
# Multi-hazard regional notes only.
NEMOTRON_ANALYST_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# News verification. Without it, confidence stays capped and is labeled unverified.
TAVILY_API_KEY=

# Optional hazard feeds. The app skips them when these are empty.
FIRMS_MAP_KEY=
OPENAQ_API_KEY=

# Leave unset for live no-key feeds. Set to snapshot to use data/demo-snapshot.json.
DEMO_MODE=
